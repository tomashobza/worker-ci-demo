{
  "name": "ci-workflows-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "oxlint src test vitest.config.ts",
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc --noEmit"
  },
  "devDependencies": {
    "oxlint": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true,
    "fsevents@2.3.3": true
  }
}
